      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "AutoCRM Login",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [60, 340],
      "notes": "AutoCRM is cookie-auth only for these routes. fullResponse:true is REQUIRED so we can read set-cookie. Login is CSRF-exempt (app/auth/cookies.py _CSRF_EXEMPT_PATHS). CHECKED: /api/leads/ingest does NOT accept X-AI-Service-Token -- it is Depends(require_auth), and the service token only works on /api/agent/*. So this node stays. See README s1.1 for why swapping the backend dependency is not the one-word fix it looks like.",
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Parse the Set-Cookie array from AutoCRM's login response into the two\n// values every later request needs: the access_token cookie and the\n// csrf_token, which must ALSO be echoed as an X-CSRF-Token header on\n// POST/PATCH/DELETE (API.md s3, \"double-submit CSRF\").\nconst res = $input.first().json;\nconst raw = res.headers?.['set-cookie'] ?? [];\nconst list = Array.isArray(raw) ? raw : [raw];\n\nconst jar = {};\nfor (const entry of list) {\n  const [pair] = String(entry).split(';');\n  const eq = pair.indexOf('=');\n  if (eq === -1) continue;\n  jar[pair.slice(0, eq).trim()] = pair.slice(eq + 1).trim();\n}\n\nif (!jar.access_token) {\n  throw new Error('AutoCRM login returned no access_token cookie. Check AUTOCRM_SERVICE_EMAIL / AUTOCRM_SERVICE_PASSWORD and that the user is_active.');\n}\n\nreturn [{\n  json: {\n    cookieHeader: `access_token=${jar.access_token}; csrf_token=${jar.csrf_token ?? ''}`,\n    csrfToken: jar.csrf_token ?? '',\n  },\n}];"
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Extract Cookies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, 340],
      "notes": "Access token TTL is 30 min (default). We log in per execution rather than caching, so TTL never matters.",
      "onError": "continueErrorOutput"
    },
